<library path="arctos_segment_controller">
  <class name="arctos_controller/ArctosSegmentController"
         type="arctos_controller::ArctosSegmentController" base_class_type="controller_interface::ControllerInterface">
    <description>
      ArctosSegmentController: FollowJointTrajectory controller that downsamples trajectory into coarse segments and commands joint positions at segment boundaries.
    </description>
  </class>
</library>

<library path="arctos_gripper_controller">
