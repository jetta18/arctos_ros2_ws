# Service for configuring MKS Servo 42D/57D motor parameters
# Request
uint32 motor_id
string command_type  # "calibrate", "set_work_mode", "set_current", "set_holding_current", "set_subdivision", "restore_defaults", "set_home_params", "go_home", "set_zero", "set_limit_remap", "enable", "query_status"

# Configuration parameters (optional, depending on command_type)
uint8 work_mode              # 0-5 (CR, CR_vFOC, SR_OPEN, SR_CLOSE, SR_FOC, SR_vFOC)
uint16 working_current_ma    # Working current in mA (e.g., 1600)
uint8 holding_current_pct    # Holding current percentage (0-100)
uint8 subdivision            # Microstep subdivision (0-8)
uint8 home_trigger_level     # Home trigger level (0-1)
uint8 home_direction         # Home direction (0=CW, 1=CCW)
uint16 home_speed_rpm        # Home speed in RPM
bool home_enable_limit       # Enable limit switch for homing
bool limit_remap_enable      # Enable limit port remapping
bool motor_enable            # Enable/disable motor

---
# Response
bool success
string message
uint8 status_code            # Status code from motor (if applicable)
